{
  "manifest_version": 3,
  "name": "JumpLex",
  "version": "0.1.1",
  "description": "右键菜单：用指定网站查询选中的单词",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png" 
  }
}